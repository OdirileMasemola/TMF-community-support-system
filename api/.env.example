# Copy to .env for local development (never commit .env).
# In Azure, set these as App Settings instead of using a .env file.

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Supabase project URL and PUBLISHABLE (anon) key. Never use the service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Comma-separated list of allowed browser origins, e.g. http://localhost:5173,https://your-web-app.example
# Empty: any origin allowed in development/test; no cross-origin access in production. "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173

# Max requests per client per minute
RATE_LIMIT_MAX=100

# Version label shown in the API docs
API_VERSION=0.1.0

# Registration email check (POST /api/v1/auth/registration/email-check)
# Requests per client per minute (default 10)
EMAIL_CHECK_RATE_LIMIT_MAX=10
# Upper bound for one MX/A/AAAA check in ms (default 3000, max 10000)
EMAIL_DNS_TIMEOUT_MS=3000
# How long a positive DNS result is cached, in seconds (default 3600; negative results: a sixth, min 60)
EMAIL_DNS_CACHE_TTL_SECONDS=3600
# Optional. At least 32 random characters. Must equal the Supabase Vault secret named
# 'email_signup_attestation_secret' (see docs/email-domain-management.md). Leave empty to disable.
# Never commit a real value.
EMAIL_SIGNUP_ATTESTATION_SECRET=
